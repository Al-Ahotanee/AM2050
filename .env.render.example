# Render Runtime + Build Environment (copy values into Render; never commit a populated file).
# Same-origin Render deployment is required. Never use a temporary *.manus.computer API hostname here.
APP_ENV=production
APP_TIMEZONE=Africa/Lagos
VITE_AM2050_API_URL=/api/v1

# Aiven for MySQL connection information (Overview → Connection information)
DB_HOST=mysql-your-service.aivencloud.com
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=REPLACE_WITH_AIVEN_PASSWORD
DB_SSL_REQUIRED=true
# base64 -w0 ca.pem on Linux/macOS. Do not add spaces or line breaks.
DB_SSL_CA_BASE64=REPLACE_WITH_BASE64_AIVEN_CA_CERTIFICATE

# Generate a unique value of at least 32 characters. Never reuse sandbox values.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
# Optional only when an independently hosted frontend must access the API.
# Use exact origins only; never use a wildcard with credentialed cookies.
# CORS_ALLOWED_ORIGIN=https://frontend.example.org
