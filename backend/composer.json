{
  "name": "arewa-mission/am2050-api",
  "description": "AM2050 pure PHP REST API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "dompdf/dompdf": "^3.1",
    "firebase/php-jwt": "^7.0",
    "phpoffice/phpspreadsheet": "^3.9",
    "symfony/uid": "^7.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "AM2050\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AM2050\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php",
    "test": "phpunit --testdox"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
